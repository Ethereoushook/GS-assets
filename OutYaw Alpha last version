    function anti_aim.OutYaw_maxfl()
        local m = menu.antiaim.maxfl
        local mode = m.mode:get()
        if mode == 'Off' then
            interface.reference.fakelag.fakelag_amount:override()
            interface.reference.fakelag.limit:override()
            interface.reference.fakelag.variance:override()
            return
        end
        local me = entity.get_local_player()
        if not me or not entity.is_alive(me) then return end
        local flags = entity.get_prop(me, 'm_fFlags') or 0
        local on_ground = bit.band(flags, 1) ~= 0
        local ducking = bit.band(flags, 4) ~= 0
        local vx = entity.get_prop(me, 'm_vecVelocity[0]') or 0
        local vy = entity.get_prop(me, 'm_vecVelocity[1]') or 0
        local speed = math.sqrt(vx * vx + vy * vy)
        local st
        if not on_ground then
            st = ducking and 'Air duck' or 'Air'
        else
            st = speed > 5 and 'Running' or 'Stand'
        end
        local ticks
        if mode == 'Maximum' then
            ticks = math.max(m.stand:get(), m.running:get(), m.air:get(), m.airduck:get())
        else
            local key = st:lower():gsub(' ', '')
            ticks = m[key]:get()
        end
        ticks = math.max(0, math.min(14, math.floor(ticks or 0)))
        pcall(function() interface.reference.fakelag.fakelag_amount:override('Maximum') end)
        interface.reference.fakelag.limit:override(ticks)
        interface.reference.fakelag.variance:override(0)
    end

