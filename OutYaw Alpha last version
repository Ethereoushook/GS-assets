                freestand_data[victim].last_hit = globals.curtime()
            end
        end)
        switch:set_event("aim_miss", function(e)
            if e.reason ~= '?' and e.reason ~= 'resolver' then
                return
            end
            local target = e.target
            if target and entity.is_enemy(target) then
                freestand_data[target] = freestand_data[target] or {}
                freestand_data[target].last_miss = globals.curtime()
            end
            if target == nil then return end
            local engine = menu.aimbot.features.OutYaw.resolver_engine:get()
            if engine == 'Test 1' then
                if e.reason == 'resolver' then
                    local rec = t1_init_player_record(target)
                    rec.misses = rec.misses + 1
                    rec.last_hit_step = -1
                end
                return
            elseif engine == 'Test 2' then
                if e.reason == 'resolver' then
                    t2_misses_tracker[target] = (t2_misses_tracker[target] or 0) + 1
                end
                return
            end
            if e.reason == 'resolver' then
                resolver_data.test_misses[target] = (resolver_data.test_misses[target] or 0) + 1
            end
        end)
        switch:set_event("aim_hit", function(e)
            if menu.aimbot.features.OutYaw.resolver_engine:get() ~= 'Test 1' then return end
            local target = e.target
            if not target or not entity.is_enemy(target) then return end
            local rec = t1_init_player_record(target)
            if rec.misses > 0 then
                rec.last_hit_step = rec.misses
                rec.misses = 0
            end
        end)
        local function paint_resolver()
            
            
