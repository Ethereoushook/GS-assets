    function render.alt_fading(text, clock, color1, color2)
        if not text or text == '' then
            return ''
        end

        local buffer = {}
        local div = #text > 1 and 1 / (#text - 1) or 1

        for char in text:gmatch('.[\128-\191]*') do
            local t = clock % 3
            t = t > 1 and 2 - t or t

            local r = color1.r + (color2.r - color1.r) * t
            local g = color1.g + (color2.g - color1.g) * t
            local b = color1.b + (color2.b - color1.b) * t
            local a = color1.a + (color2.a - color1.a) * t

            buffer[#buffer + 1] = '\a' .. color.new(r, g, b, a):to_hex() .. char
            clock = clock + div
        end

        return table.concat(buffer)
    end
    function render.gradient_text(text, clock, color1, color2)
