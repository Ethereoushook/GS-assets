        local function render_hitlog(list, preview)
            local sw, sh = client.screen_size()
            local ox = menu.misc.hitlog_x:get()
            local oy = menu.misc.hitlog_y:get()
            local font = oy_font or ''
            local pad_v = 2

            local cx = math.floor(sw / 2 + ox)
            local base_y = math.floor(sh * 0.33 + oy)
            local now = globals.realtime()
            local fade = not preview and menu.misc.hitlog_anim:get()

            for i, en in ipairs(list) do
                local segs = en.segs
                local total_w = 0
                for _, s in ipairs(segs) do
                    total_w = total_w + render.measure_text(font, s.t).x
                end
                local th = render.measure_text(font, 'Ag').y

                local a = preview and 0.7 or 1
                local yoff = (i - 1) * (th + 4)
                if fade then
                    local age = now - en.spawn
                    local fade_dur = 1.2
                    a = math.max(0, math.min(1, (lifetime - age) / fade_dur))
                end

                local by = math.floor(base_y + yoff)
                local tx = math.floor(cx - total_w / 2)

                for _, s in ipairs(segs) do
                    local w = render.measure_text(font, s.t).x
                    render.text(vector(tx, math.floor(by + pad_v)), color.new(s.c[1], s.c[2], s.c[3], math.floor(255 * a)), font, 0, s.t)
                    tx = tx + w
                end
            end
        end

