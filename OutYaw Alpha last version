    local custom_scope = {} do
        local switch = menu.visuals.crosshair
        local style = menu.visuals.custom_scope_style
        local color_1 = menu.visuals.color_1 
        local color_2 = menu.visuals.color_2
        local animation_speed_setting = menu.visuals.crosshair_frame

        local progress = 0
        local last_frame_time = 0

        local function animate_progress(scoped, delta_time)
            local target = scoped and 1 or 0
            local animation_speed = animation_speed_setting:get() > 0 and animation_speed_setting:get() * 0.1 or 1

            if animation_speed_setting:get() == 0 then
                progress = target
            else
                local speed = animation_speed * delta_time * 10
                progress = progress + (target - progress) * speed
            end

            if math.abs(target - progress) < 0.01 then
                progress = target
            end
        end

        function custom_scope.paint_ui()
            local me = entity.get_local_player()
            if not me then return end
            interface.reference.visuals.scope:override(true)
        end

        function custom_scope.render()
            local me = entity.get_local_player()
            if not me then return end
        
            interface.reference.visuals.scope:override(false)
        
            local scoped_state = entity.get_prop(me, 'm_bIsScoped') == 1
        
            local current_time = globals.realtime()
            local delta_time = current_time - (last_frame_time or current_time)
            last_frame_time = current_time
        
            animate_progress(scoped_state, delta_time)
        
            if progress <= 0.01 then return end
        
            local screen_w, screen_h = client.screen_size()
            local cx, cy = screen_w / 2, screen_h / 2
        
            local r1, g1, b1, a1 = color_1:get_color()
            local r2, g2, b2, a2 = color_2:get_color()
        
            a1 = math.floor(((a1 ~= nil and a1) or 255))
            a2 = math.floor(((a2 ~= nil and a2) or 255))
        
            local gap_base = menu.visuals.custom_scope_gap and menu.visuals.custom_scope_gap:get() or 4
            local offset_base = menu.visuals.custom_scope_lines_offset and menu.visuals.custom_scope_lines_offset:get() or 10
        
            local gap = math.floor(gap_base * progress + 0.5)
            local offset = math.floor(offset_base * progress + 0.5)
        
            local style_val = style:get()
        
            if style_val == 'Default' then
                
                renderer.gradient(cx - gap - offset, cy, offset, 1, r1, g1, b1, a1, r2, g2, b2, a2, true)
                
                renderer.gradient(cx + gap, cy, offset, 1, r2, g2, b2, a2, r1, g1, b1, a1, true)
                
                renderer.gradient(cx, cy - gap - offset, 1, offset, r1, g1, b1, a1, r2, g2, b2, a2, false)
                
                renderer.gradient(cx, cy + gap, 1, offset, r2, g2, b2, a2, r1, g1, b1, a1, false)
            elseif style_val == 'T-Style' then
                renderer.gradient(cx - gap - offset, cy, offset, 1, r1, g1, b1, a1, r2, g2, b2, a2, true)
                renderer.gradient(cx + gap, cy, offset, 1, r2, g2, b2, a2, r1, g1, b1, a1, true)
                renderer.gradient(cx, cy + gap, 1, offset, r2, g2, b2, a2, r1, g1, b1, a1, false)
            end
        end

        switch:set_event('paint', custom_scope.render, function(this)
            return this:get()
        end)

