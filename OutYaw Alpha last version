        local shot_recharge = { start = -10, dur = 0.3 }
        local last_next_primary = nil
        local shot_timer_pos = { x = nil, y = nil }
local shot_timer_mode = 0
        local function paint_shot_timer()
            local st = menu.aimbot.features.OutYaw.shot_timer
            if not st.enable:get() then return end
            local me = entity.get_local_player()
            if not me or not entity.is_alive(me) then return end
            local cur = globals.curtime()
            local weapon = entity.get_player_weapon(me)
            local next_fire = weapon and entity.get_prop(weapon, 'm_flNextPrimaryAttack') or 0
            if next_fire == nil then next_fire = 0 end
            if last_next_primary and next_fire > last_next_primary + 0.001 then
                shot_recharge.start = cur
                shot_recharge.dur = math.max(0.05, math.min(next_fire - cur, 6))
            end
            last_next_primary = next_fire
            local progress = 100
            local dur = shot_recharge.dur
            if dur and dur > 0 then
                progress = (cur - shot_recharge.start) / dur * 100
                if progress < 0 then progress = 0 end
                if progress > 100 then progress = 100 end
            end
            if not progress or progress ~= progress then progress = 100 end
            local w = st.w:get()
            local h = st.h:get()
            local screen_w = client.screen_size() or 1920
            local scoped = false
            if me and entity.is_alive(me) then
                local wpn = entity.get_player_weapon(me)
                if wpn then
                    local zl = entity.get_prop(wpn, 'm_zoomLevel')
                    if zl and zl > 0 then scoped = true end
                end
            end
            local center_x = math.floor(screen_w / 2 - w / 2)
            local use_center = (st.pos:get() == 'Center X')
            local x_unscoped = use_center and center_x or st.x:get()
            local x_scoped = use_center and center_x or st.scope_x:get()
            local y_unscoped = st.y:get()
            local y_scoped = st.scope_y:get()
            local ft = globals.frametime() or 0.016
            local spd = st.move_speed:get()
            local mode_target = scoped and 1 or 0
            shot_timer_mode = shot_timer_mode + (mode_target - shot_timer_mode) * math.min(1, ft * spd)
            local target_x = x_unscoped * (1 - shot_timer_mode) + x_scoped * shot_timer_mode
            local target_y = y_unscoped * (1 - shot_timer_mode) + y_scoped * shot_timer_mode
            if shot_timer_pos.x == nil then
                shot_timer_pos.x = target_x
                shot_timer_pos.y = target_y
            end
            shot_timer_pos.x = shot_timer_pos.x + (target_x - shot_timer_pos.x) * math.min(1, ft * spd)
            shot_timer_pos.y = shot_timer_pos.y + (target_y - shot_timer_pos.y) * math.min(1, ft * spd)
            local x = math.floor(shot_timer_pos.x)
            local y = math.floor(shot_timer_pos.y)
            renderer.rectangle(x, y, w, h, 0, 0, 0, 255)
            local r, g, b, a = 255, 255, 255, 255
            if st.color_mode:get() == 'Accent' then
                r, g, b, a = menu.visuals.accent:get()
            else
                r, g, b, a = st.color:get()
            end
            local fill_w = math.max(0, math.floor(w * progress / 100))
            if fill_w > 0 then
                renderer.rectangle(x, y, fill_w, h, r, g, b, a)
            end
            renderer.rectangle(x, y, w, 2, 0, 0, 0, 255)
            renderer.rectangle(x, y + h - 2, w, 2, 0, 0, 0, 255)
            renderer.rectangle(x, y, 2, h, 0, 0, 0, 255)
            renderer.rectangle(x + w - 2, y, 2, h, 0, 0, 0, 255)
            if st.text:get() then
                local txt = math.floor(progress) .. '%'
                renderer.text(x + math.floor(w / 2), y + math.floor(h / 2), 230, 230, 230, 255, 'c', 0, txt)
            end
        end
        switch:set_event('paint', paint_shot_timer)
        local function round_start()
            local players = get_entities(true, true)
            for _, player in pairs(players) do
                resolver_data.test_misses[player] = nil
            end
        end
        switch:set_event('round_start', round_start)
        local function player_connect_full(e)
            local ent = client.userid_to_entindex(e.userid)
            if ent == entity.get_local_player() then
                resolver_data.test_misses = {}
            end
        end
        switch:set_event('player_connect_full', player_connect_full)
        client.register_esp_flag('RESTORING', 255, 100, 100, function(ent)
            if not switch:get() then return end
            if not menu.aimbot.features.OutYaw.visualize:get() then return end
            if not entity.is_enemy(ent) then return end
            if player_data[ent] and player_data[ent].defensive_triggered then
                return true, 'RESTORING'
            end
        end)
    end

    local recharge = {} do
        local switch = menu.aimbot.features.global.improvements
        local enable = menu.aimbot.features.global.aircharge
        local buffer = ffi.new('char[?]', 0x1D)
        local ogbytes = ffi.new('char[?]', 0x1D)
        local ptr = ffi.cast('char*', 0x433AC04B)
        ffi.copy(ogbytes, ptr, 0x1D)
        ffi.copy(buffer, ogbytes, 0x1D)
        ffi.fill(buffer, 0x18, 0x90)
        buffer[0x18] = 0xE9
        enable:set_callback(function (this)
            if not switch:get('Neverlose recharge') then
                return ffi.copy(ptr, ogbytes, 0x1D)
            end
            if this:get() then
                ffi.copy(ptr, buffer, 0x1D)
            else
                ffi.copy(ptr, ogbytes, 0x1D)
            end
        end, true)
    end
