local color = {} do
    function color.new(r, g, b, a)
        if type(r) == 'string' then
            local hex = r:gsub('#', '')
            if #hex == 6 then
                r = tonumber(hex:sub(1,2), 16)
                g = tonumber(hex:sub(3,4), 16)
                b = tonumber(hex:sub(5,6), 16)
                a = 255
            elseif #hex == 8 then
                r = tonumber(hex:sub(1,2), 16)
                g = tonumber(hex:sub(3,4), 16)
                b = tonumber(hex:sub(5,6), 16)
                a = tonumber(hex:sub(7,8), 16)
            else
                error('HEX error, report this and wait fix!', 2)
            end
        elseif type(r) == 'table' then
            if #r == 3 then
                r, g, b, a = tonumber(r[1]), tonumber(r[2]), tonumber(r[3]), 255
            elseif #r == 4 then
                r, g, b, a = tonumber(r[1]), tonumber(r[2]), tonumber(r[3]), tonumber(r[4])
            else
                error('Table convert color error, report this and wait fix!', 2)
            end
        end

        local self = { r, g, b, a }
        self.r = tonumber(r) or 255
        self.g = tonumber(g) or 255
        self.b = tonumber(b) or 255
        self.a = tonumber(a) or 255

        self.r = math.clamp(self.r, 0, 255)
        self.g = math.clamp(self.g, 0, 255)
        self.b = math.clamp(self.b, 0, 255)
        self.a = math.clamp(self.a, 0, 255)

        setmetatable(self, {
            __index = color,
        })

        return self
    end

    function color:to_hex()
        return string.format('%02X%02X%02X%02X', self.r, self.g, self.b, self.a)
    end

    function color:lerp(second_color, anim)
        if type(anim) == 'boolean' then
            anim = anim and 1 or 0
        end

        anim = math.clamp(anim, 0, 1)
        return color.new(
            math.round(math.lerp(self.r, second_color.r, anim)),
            math.round(math.lerp(self.g, second_color.g, anim)),
            math.round(math.lerp(self.b, second_color.b, anim)),
            math.round(math.lerp(self.a, second_color.a, anim))
        )
    end

    function color:alpha_modulate(alpha)
        return color.new(self.r, self.g, self.b, alpha)
    end

    
    function color:to_array()
        return {self.r, self.g, self.b, self.a}
    end
end

