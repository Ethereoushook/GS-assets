local function config_system()
        local config_information = { list = {}, id = 1 }
        local config_list = aa_group:listbox('Configs', #configs:get_configs() > 0 and configs:get_configs() or { 'No configs' }):depend({ menu.shared.tab, 'Home' })
        local selected = aa_group:label('Selected: \vNothing'):depend({ menu.shared.tab, 'Home' })
        local config_name = aa_group:textbox('Name config'):depend({ menu.shared.tab, 'Home' })
        local get_loading_objects = aa_group:multiselect('Loading objects:', {'Rage' ,'Antiaim', 'Visuals', 'Misc'}):depend({ menu.shared.tab, 'Home' })

        client.set_event_callback('paint_ui', function()
            if not ui.is_menu_open() then
                return
            end

            local list = configs:get_configs()
            if #list ~= #config_information.list then
                config_information.list = list
        
                if #list == 0 then
                    config_list:update({ 'No configs' })
                    config_list.value = 1
                    config_information.id = 1
                    return
                else
                    local clean = {}
                    for i = 1, #list do
                        clean[i] = tostring(list[i]):match('^([^|]+)') or tostring(list[i])
                    end
                    config_list:update(clean)
                    return
                end
            end
        
            if config_list.value == nil then
                config_list.value = 1
            end
        
            local id = (config_list.value or 1) + 1
            if id ~= config_information.id then
                config_information.id = id
                return
            end
        end)
        
        local function validate_config_name()
            local name = config_name:get():gsub(' ', '')
            if name == '' then
                return true, 'Untitled'
            end

            return true, name
        end

        local function validate_config_exists(id)
            if #configs:get_configs() <= 0 then
                print('No configs available')
                return false, nil
            end

            local config = configs:get(id)
            if not config then
                print('Config not found.')
                return false, nil
            end

            return true, config
        end

        local b64alphabet = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_'
        local function b64enc(data)
            local t = {}
            for i = 1, #data, 3 do
                local a, b, c = data:byte(i, i + 2)
                b = b or 0; c = c or 0
                local n = a * 65536 + b * 256 + c
                t[#t + 1] = b64alphabet:sub(math.floor(n / 262144) % 64 + 1, math.floor(n / 262144) % 64 + 1)
                t[#t + 1] = b64alphabet:sub(math.floor(n / 4096) % 64 + 1, math.floor(n / 4096) % 64 + 1)
                if i + 1 <= #data then t[#t + 1] = b64alphabet:sub(math.floor(n / 64) % 64 + 1, math.floor(n / 64) % 64 + 1) else t[#t + 1] = '=' end
                if i + 2 <= #data then t[#t + 1] = b64alphabet:sub(n % 64 + 1, n % 64 + 1) else t[#t + 1] = '=' end
            end
            return table.concat(t)
        end

        local function b64dec(s)
            s = s:gsub('=', '')
            local t = {}
            for i = 1, #s, 4 do
                local pa, pb, pc, pd = s:sub(i, i), s:sub(i + 1, i + 1), s:sub(i + 2, i + 2), s:sub(i + 3, i + 3)
                local function cv(ch)
                    if ch == '' then return 0 end
                    local x = ch:byte()
                    if x >= 65 and x <= 90 then return x - 65 end
                    if x >= 97 and x <= 122 then return x - 71 end
                    if x >= 48 and x <= 57 then return x + 4 end
                    if x == 45 then return 62 end
                    if x == 95 then return 63 end
                    return 0
                end
                local a, b, c, d = cv(pa), cv(pb), cv(pc), cv(pd)
                local n = a * 262144 + b * 4096 + c * 64 + d
                t[#t + 1] = string.char(math.floor(n / 65536) % 256)
                if pc ~= '' then t[#t + 1] = string.char(math.floor(n / 256) % 256) end
                if pd ~= '' then t[#t + 1] = string.char(n % 256) end
            end
            return table.concat(t)
        end

        local function is_control(v)
            return type(v) == 'table' and type(v.get) == 'function' and type(v.set) == 'function'
        end

        local function ser_val(v)
            if type(v) == 'boolean' then
                return 'B' .. (v and '1' or '0')
            elseif type(v) == 'number' then
                return 'N' .. tostring(v)
            elseif type(v) == 'string' then
                return 'S' .. v
                elseif type(v) == 'table' then
                    if v.r ~= nil and v.g ~= nil and v.b ~= nil then
                        local a = v.a ~= nil and v.a or 255
                        return 'C' .. v.r .. ',' .. v.g .. ',' .. v.b .. ',' .. a
                    end
                    local arr = {}
                local ok = true
                for k, val in pairs(v) do
                    if type(k) ~= 'number' then ok = false; break end
                    arr[#arr + 1] = tostring(val)
                end
                if not ok then return nil end
                return 'A' .. table.concat(arr, ',')
            end
            return nil
        end

        local function deser_val(s)
            local t = s:sub(1, 1)
            local d = s:sub(2)
            if t == 'B' then return d == '1'
            elseif t == 'N' then return tonumber(d)
            elseif t == 'S' then return d
            elseif t == 'A' then
                local arr = {}
                if d ~= '' then for val in d:gmatch('[^,]+') do arr[#arr + 1] = val end end
                return arr
            elseif t == 'C' then
                local arr = {}
                for val in d:gmatch('[^,]+') do arr[#arr + 1] = tonumber(val) end
                return { r = arr[1], g = arr[2], b = arr[3], a = arr[4] }
            end
            return nil
        end

        local function serialize_menu(tbl, prefix, out)
            for k, v in pairs(tbl) do
                if k == 'config' or k == 'shared' then goto continue end
                local key = (prefix == '' and tostring(k)) or (prefix .. '.' .. tostring(k))
                if type(v) == 'table' then
                    if is_control(v) then
                        local ok, val = pcall(function() return v:get() end)
                        if ok then
                            local s = ser_val(val)
                            if s then out[key] = s end
                        end
                    end
                    pcall(serialize_menu, v, key, out)
                end
                ::continue::
            end
        end

        local function apply_menu(data)
            local loading = get_loading_objects:get() or {}
            local filter_on = #loading > 0
            local known = { aimbot = true, antiaim = true, visuals = true, misc = true }
            local allowed = {}
            local map = { Rage = 'aimbot', Antiaim = 'antiaim', Visuals = 'visuals', Misc = 'misc' }
            for _, cat in ipairs(loading) do
                local mk = map[cat]
                if mk then allowed[mk] = true end
            end
            for path, s in pairs(data) do
                local parts = {}
                if filter_on then
                    local top = path:match('^([^.]+)')
                    if top and known[top] and not allowed[top] then
                        goto skip
                    end
                end
                for p in path:gmatch('[^.]+') do parts[#parts + 1] = p end
                local node = menu
                local ok = true
                for i = 1, #parts - 1 do
                    node = node[parts[i]]
                    if type(node) ~= 'table' then ok = false; break end
                end
                if not ok or not node then goto skip end
                local ctrl = node[parts[#parts]]
                if not is_control(ctrl) then goto skip end
                local val = deser_val(s)
                if val == nil then goto skip end
                if type(val) == 'table' then
                    local set_ok = pcall(function() ctrl:set(table.unpack(val)) end)
                    if not set_ok then pcall(function() ctrl:set(val) end) end
                else
                    pcall(function() ctrl:set(val) end)
                end
                ::skip::
            end
        end

        local function encode_menu(data)
            local parts = {}
            for k, v in pairs(data) do parts[#parts + 1] = k .. '=' .. v end
            table.sort(parts)
            return b64enc(table.concat(parts, '\n'))
        end

        local function decode_menu(blob)
            local ok, str = pcall(b64dec, blob)
            if not ok or not str or str == '' then return {} end
            local data = {}
            for line in str:gmatch('[^\n]+') do
                local k, v = line:match('^([^\n=]+)=(.*)$')
                if k and v then data[k] = v end
            end
            return data
        end

        local function apply_config(config)
            local loading = get_loading_objects:get() or {}
            for index, value in ipairs(loading) do
                if value == 'Visuals' then pcall(configs.import, configs, config.code, 'visuals') end
