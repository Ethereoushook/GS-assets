                rec.is_flicking = true
                rec.jitter_score = t1_clamp(rec.jitter_score + 1, 0, 10)
            elseif math.abs(yaw_delta) < 5.0 then
                rec.is_flicking = false
                rec.jitter_score = t1_clamp(rec.jitter_score - 1, 0, 10)
            end
            rec.last_yaw = current_yaw
            if rec.last_hit_step ~= -1 and rec.misses == 0 then
                local step = rec.last_hit_step % #t1_BRUTE_STEPS
                final_yaw = max_desync * t1_BRUTE_STEPS[step]
            elseif rec.misses == 0 then
                if state.m_flSpeed2D > 0.1 and state.m_bOnGround and state.m_fDuckAmount < 0.2 then
                    final_yaw = 0.0
                elseif not state.m_bOnGround then
                    final_yaw = max_desync * 0.5
                else
                    local layers = t1_get_anim_layers_raw(entindex)
                    local side = t1_solve_side_from_layers(layers)
                    if rec.is_flicking then
                        local base_delta = t1_normalize_yaw(state.m_flEyeYaw - state.m_flGoalFeetYaw)
                        local raw_side = base_delta >= 0 and 1 or -1
                        final_yaw = max_desync * (raw_side * -1.0)
                    elseif rec.jitter_score > 5 then
                        final_yaw = max_desync * (side ~= 0 and (side * 0.5) or 0.25)
                    else
                        if side ~= 0 then
                            final_yaw = max_desync * side
                        else
                            local delta = t1_normalize_yaw(state.m_flEyeYaw - state.m_flGoalFeetYaw)
                            final_yaw = delta >= 0 and max_desync or -max_desync
                        end
                    end
                end
            else
                local step = rec.misses % #t1_BRUTE_STEPS
                final_yaw = max_desync * t1_BRUTE_STEPS[step]
            end
            plist.set(entindex, "Force body yaw", true)
            plist.set(entindex, "Force body yaw value", t1_clamp(final_yaw, -max_desync, max_desync))
        end

        
        
        
        local t2_misses_tracker = {}
        local t2_BRUTE_STEPS = {
            [0] = 0,
            [1] = 1.0,
            [2] = -1.0,
            [3] = 0.5,
            [4] = -0.5,
            [5] = 0.25,
            [6] = -0.25,
        }
        local function t2_normalize_yaw(yaw)
            while yaw > 180 do yaw = yaw - 360 end
            while yaw < -180 do yaw = yaw + 360 end
            return yaw
        end
        local function t2_clamp(val, min_val, max_val)
            if val < min_val then return min_val end
            if val > max_val then return max_val end
            return val
        end
        local function t2_get_animstate_raw(entindex)
            local ok, ent_ptr = pcall(entity.get_address, entindex)
            if not ok or not ent_ptr or ent_ptr == 0 then return nil end
            local animstate_ptr = ffi.cast("struct animstate_t1**", ffi.cast("uintptr_t", ent_ptr) + 0x9960)[0]
            if animstate_ptr == nil or ffi.cast("uintptr_t", animstate_ptr) == 0 then
                animstate_ptr = ffi.cast("struct animstate_t1**", ffi.cast("uintptr_t", ent_ptr) + 0x3914)[0]
            end
            return animstate_ptr
        end
        local function t2_get_anim_layers_raw(entindex)
            local ok, ent_ptr = pcall(entity.get_address, entindex)
            if not ok or not ent_ptr or ent_ptr == 0 then return nil end
            return ffi.cast("struct animation_layer_t**", ffi.cast("uintptr_t", ent_ptr) + 0x2990)[0]
        end
        local function t2_get_max_desync_delta(animstate)
            local max_yaw = animstate.m_flMaxYaw
            if max_yaw <= 0.0 or max_yaw > 60.0 then
                max_yaw = 58.0
            end
            local speed_fraction = t2_clamp(animstate.m_flFeetSpeedForwardsOrSideWays, 0.0, 1.0)
            local speed_factor = t2_clamp(animstate.m_flFeetSpeedUnknownForwardOrSideways, 0.0, 1.0)
            local modifier = (animstate.m_flUnknownFloat1 * -0.3 - 0.2) * speed_fraction + 1.0
            if animstate.m_fDuckAmount > 0.0 then
                modifier = modifier + (animstate.m_fDuckAmount * speed_factor * (0.5 - modifier))
            end
            return t2_clamp(max_yaw * modifier, 0.0, 58.0)
        end
        local function t2_solve_side_from_layers(layers)
            if layers == nil then return 0 end
            local move_layer = layers[6]
            if move_layer ~= nil then
                if move_layer.m_flWeight > 0.05 and move_layer.m_flPlaybackRate > 0.001 then
                    if move_layer.m_flPlaybackRate < 0.018 then
                        return 1
                    elseif move_layer.m_flPlaybackRate > 0.042 then
                        return -1
                    end
                end
            end
            local adjust_layer = layers[3]
            if adjust_layer ~= nil and adjust_layer.m_flWeight > 0.0 then
                return adjust_layer.m_flCycle < 0.5 and -1 or 1
            end
            return 0
        end
        local function apply_test2_resolver(entindex)
            if not entindex or not entity.is_enemy(entindex) then return end
            if plist.get(entindex, 'Add to whitelist') then return end
            if not menu.aimbot.features.OutYaw.apply:get() then
                if not plist.get(entindex, 'Add to whitelist') then
                    plist.set(entindex, 'Force body yaw', false)
                end
                return
            end
            local state = t2_get_animstate_raw(entindex)
            if state == nil or ffi.cast("uintptr_t", state) == 0 then return end
            local misses = t2_misses_tracker[entindex] or 0
            local max_desync = t2_get_max_desync_delta(state)
            local final_yaw = 0.0
            if misses == 0 then
                if state.m_flSpeed2D > 0.1 and state.m_bOnGround and state.m_fDuckAmount < 0.2 then
                    final_yaw = 0.0
                elseif not state.m_bOnGround then
                    final_yaw = max_desync * 0.5
                else
                    local layers = t2_get_anim_layers_raw(entindex)
                    local side = t2_solve_side_from_layers(layers)
                    if side ~= 0 then
                        final_yaw = max_desync * side
                    else
                        local delta = t2_normalize_yaw(state.m_flEyeYaw - state.m_flGoalFeetYaw)
                        final_yaw = delta >= 0 and max_desync or -max_desync
                    end
                end
            else
                local step = misses % #t2_BRUTE_STEPS
                final_yaw = max_desync * t2_BRUTE_STEPS[step]
            end
            plist.set(entindex, "Force body yaw", true)
            plist.set(entindex, "Force body yaw value", t2_clamp(final_yaw, -max_desync, max_desync))
        end

        switch:set_event('player_death', function(e)
            local v = client.userid_to_entindex(e.userid)
            if v then
                resolver_data.test_misses[v] = 0
                local rec = t1_records[v]
