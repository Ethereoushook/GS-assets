        [1024] = 'Pin pulled',
        [2048] = 'Hit',
        [4096] = 'Occluded',
        [8192] = 'Exploiter',
        [131072] = 'Defensive dt'
    }

    local esp_data = entity.get_esp_data(player)
    local result = false

    for i, name in pairs(flags) do
